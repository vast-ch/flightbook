{
	"appId": "ch.flightbook",
	"appName": "Flightbook",
	"webDir": "www/browser",
	"cordova": {},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"showSpinner": false,
			"splashFullScreen": true
		},
		"Keyboard": {
			"resizeOnFullScreen": true
		},
		"SystemBars": {
			"style": "LIGHT"
		},
		"StatusBar": {
			"style": "LIGHT"
		}
	},
	"ios": {
		"scheme": "Flightbook"
	}
}
