# Environment for running flightbook-api locally against the e2e Postgres.
# Dummy values only — nothing here talks to a real external service.
# Login goes through the API's legacy JWT path (signed with JWT_SECRET), so
# Keycloak is pointed at a closed port and never reached.
export TZ=UTC
export DATABASE_HOST=localhost
export DATABASE_PORT=55432
export DATABASE_USER=fb
export DATABASE_PASSWORD=fb
# init-schema.sql in flightbook-api/test hardcodes this database name.
export DATABASE_NAME=flightbook_test
export DATABASE_SCHEMA=data
export DATABASE_SSL=false
export JWT_SECRET=local-e2e-secret
export STRIPE_ENDPOINT_SECRET=test
export STRIPE_SECRET_KEY=sk_test_dummy
export ORIGIN_INSTRUCTOR=http://localhost:4200
export ORIGIN_MOBILE=http://localhost:4300
export INSTRUCTOR_APP_URL=http://localhost:4200
export ANDROID_MINIMAL_VERSION_BUILD=1
export IOS_MINIMAL_VERSION_BUILD=1
export ANDROID_LATEST_BUILD=2
export IOS_LATEST_BUILD=2
export MAP_URL='https://tile.openstreetmap.org/{z}/{x}/{y}.png'
export MAP_ATTRIBUTIONS=OSM
export MAP_CROSS_ORIGIN=anonymous
export MAP_TERRAIN_URL='https://tile.openstreetmap.org/{z}/{x}/{y}.png'
export MAP_TERRAIN_ATTRIBUTIONS=OSM
export KEYCLOAK_BASE_URL=http://localhost:1
export LOG_LEVELS=error,warn,log
