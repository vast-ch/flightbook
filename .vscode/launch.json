{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Jest Current e2e Test File (API)",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.11.1/bin/node",
      "program": "${workspaceFolder}/flightbook-api/node_modules/.bin/jest",
      "args": [
        "${fileBasenameNoExtension}",
        "--config",
        "./test/jest-e2e.json",
        "--testTimeout",
        "10000"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/flightbook-api",
      "windows": {
        "program": "${workspaceFolder}/flightbook-api/node_modules/jest/bin/jest"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Jest Current IT Test File (API)",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.11.1/bin/node",
      "program": "${workspaceFolder}/flightbook-api/node_modules/.bin/jest",
      "args": [
        "${fileBasenameNoExtension}",
        "--config",
        "./test/it/it.jest.json",
        "--testTimeout",
        "10000"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/flightbook-api",
      "windows": {
        "program": "${workspaceFolder}/flightbook-api/node_modules/jest/bin/jest"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Jest Current Test File (API)",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.11.1/bin/node",
      "program": "${workspaceFolder}/flightbook-api/node_modules/.bin/jest",
      "args": [
        "${fileBasenameNoExtension}",
        "--testTimeout",
        "10000",
        "--coverage"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/flightbook-api",
      "windows": {
        "program": "${workspaceFolder}/flightbook-api/node_modules/jest/bin/jest"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Nest Framework (API)",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.11.1/bin/node",
      "args": ["${workspaceFolder}/flightbook-api/src/main.ts"],
      "runtimeArgs": [
        "--nolazy",
        "-r",
        "ts-node/register",
        "-r",
        "tsconfig-paths/register"
      ],
      "sourceMaps": true,
      "envFile": "${workspaceFolder}/flightbook-api/.env",
      "cwd": "${workspaceFolder}/flightbook-api",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to npm run start:debug (API)",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/flightbook-api",
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true
    }
  ]
}
