---
import Layout from '~/layouts/PageLayout.astro';
import FlightbookHero from '~/components/widgets/FlightbookHero.astro';
import FlightbookPricing from '~/components/widgets/FlightbookPricing.astro';
import FlightbookPremiumFeatures from '~/components/widgets/FlightbookPremiumFeatures.astro';
import FlightbookSchoolsFeatures from '~/components/widgets/FlightbookSchoolsFeatures.astro';
import FlightbookFAQ from '~/components/widgets/FlightbookFAQ.astro';
import { getTranslations } from '~/utils/i18n';
import heroPhoto from '~/assets/images/Paraglider_Main.jpg';
import heroScreenshot from '~/assets/images/flightbook/home.png';

const t = getTranslations('fr');

const metadata = {
  title: t.meta.title,
  description: t.meta.description,
  canonical: 'https://flightbook.ch/fr',
  openGraph: {
    title: t.meta.ogTitle,
    description: t.meta.ogDescription,
    type: 'website',
    url: 'https://flightbook.ch/fr',
    images: [
      {
        url: 'https://raw.githubusercontent.com/laggery/Flightbook-MobileApp/7d738a8497449768f4a38d647cfdf7da138f77b6/src/assets/icons/icon-128x128.png',
        width: 128,
        height: 128,
        alt: 'Flightbook App Icon',
      },
    ],
  },
  robots: {
    index: true,
    follow: true,
  },
};

const pricingPlans = [
  {
    badge: t.pricing.free.badge,
    title: t.pricing.free.title,
    price: t.pricing.free.price,
    features: t.pricing.free.features,
    cta: t.pricing.free.cta,
    ctaLink: 'https://m.flightbook.ch/register',
    featured: false,
  },
  {
    badge: t.pricing.premium.badge,
    title: t.pricing.premium.title,
    price: t.pricing.premium.price,
    period: t.pricing.premium.period,
    features: t.pricing.premium.features,
    cta: t.pricing.premium.cta,
    ctaLink: 'https://m.flightbook.ch/settings',
    featured: true,
  },
  {
    badge: t.pricing.schools.badge,
    title: t.pricing.schools.title,
    price: t.pricing.schools.price,
    features: t.pricing.schools.features,
    cta: t.pricing.schools.cta,
    ctaLink: 'https://instructor.flightbook.ch/school/register',
    featured: false,
  },
];
---

<Layout metadata={metadata}>
  <FlightbookHero
    eyebrow={t.hero.eyebrow}
    titleLine1={t.hero.titleLine1}
    titleLine2={t.hero.titleLine2}
    subtitle={t.hero.subtitle}
    ios={t.hero.ios}
    android={t.hero.android}
    premium={t.hero.subscribePremium}
    stats={t.hero.stats}
    photo={heroPhoto}
    screenshot={heroScreenshot}
    screenshotAlt={t.hero.screenshotAlt}
  />

  <FlightbookPricing title={t.pricing.title} plans={pricingPlans} notes={t.pricing.notes} />

  <FlightbookPremiumFeatures title={t.features.title} features={t.features.items.slice(0, 4)} cta={t.features.cta} />

  <FlightbookSchoolsFeatures title={t.schools.title} features={t.schools.items} cta={t.schools.cta} />

  <FlightbookFAQ title={t.faq.title} faqs={t.faq.questions} />
</Layout>
