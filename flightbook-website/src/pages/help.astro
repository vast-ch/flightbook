---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Help - Flightbook',
  description: 'Need help with Flightbook? Contact us for support, questions, or suggestions.',
  robots: {
    index: true,
    follow: true,
  },
  languageAlternates: [
    { hrefLang: 'de', href: 'https://flightbook.ch/help' },
    { hrefLang: 'fr', href: 'https://flightbook.ch/fr/help' },
    { hrefLang: 'x-default', href: 'https://flightbook.ch/help' },
  ],
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-8 font-heading">
        Hilfe & Support
      </h1>
    </div>
    
    <div class="prose prose-lg dark:prose-invert max-w-none">
      <div class="bg-blue-50 dark:bg-slate-800 rounded-lg p-8 mb-8">
        <h2 class="text-2xl font-bold mb-4">Haben Sie ein Problem?</h2>
        <p class="text-lg mb-4">
          Wenn Sie Probleme, Fragen oder Verbesserungsvorschläge haben, senden Sie mir ein E-Mail an:
        </p>
        <p class="text-xl">
          <a 
            href="mailto:yannick.lagger@flightbook.ch" 
            class="text-primary hover:text-accent font-semibold"
          >
            yannick.lagger@flightbook.ch
          </a>
        </p>
      </div>

      <div class="bg-gray-50 dark:bg-slate-800/50 rounded-lg p-8 mb-8">
        <h2 class="text-2xl font-bold mb-4">Have you a problem?</h2>
        <p class="text-lg mb-4">
          If you have problems, questions or suggestions please send me an e-mail at:
        </p>
        <p class="text-xl">
          <a 
            href="mailto:yannick.lagger@flightbook.ch" 
            class="text-primary hover:text-accent font-semibold"
          >
            yannick.lagger@flightbook.ch
          </a>
        </p>
      </div>

      <div class="bg-blue-50 dark:bg-slate-800 rounded-lg p-8">
        <h2 class="text-2xl font-bold mb-4">Avez-vous un problème?</h2>
        <p class="text-lg mb-4">
          Si vous avez des problèmes, des questions ou des suggestions n'hésitez pas à me contacter à l'adresse mail suivante:
        </p>
        <p class="text-xl">
          <a 
            href="mailto:yannick.lagger@flightbook.ch" 
            class="text-primary hover:text-accent font-semibold"
          >
            yannick.lagger@flightbook.ch
          </a>
        </p>
      </div>

      <div class="text-center mt-12 text-muted">
        <p class="text-lg">— Yannick Lagger</p>
      </div>
    </div>
  </section>
</Layout>
