---
import Image from '~/components/common/Image.astro';
import home1DE from '~/assets/images/flightbook/mobile/Apple1DE.png';
import controlSheetDE from '~/assets/images/flightbook/mobile/Apple2DE.png';
import addFlightDE from '~/assets/images/flightbook/mobile/Apple3DE.png';
import statisticDE from '~/assets/images/flightbook/mobile/Apple4DE.png';
import tandemDE from '~/assets/images/flightbook/mobile/Apple5DE.png';
import home1FR from '~/assets/images/flightbook/mobile/Apple1FR.png';
import controlSheetFR from '~/assets/images/flightbook/mobile/Apple2FR.png';
import addFlightFR from '~/assets/images/flightbook/mobile/Apple3FR.png';
import statisticFR from '~/assets/images/flightbook/mobile/Apple4FR.png';
import tandemFR from '~/assets/images/flightbook/mobile/Apple5FR.png';

interface Feature {
  title: string;
  description: string;
}

interface Props {
  title: string;
  features: Feature[];
  cta: string;
  lang?: 'de' | 'fr';
}

const { title, features, cta, lang = 'de' } = Astro.props;

const imagesByLang = {
  de: [
    { src: home1DE, alt: 'Flightbook App Startseite - Übersicht der Flugverwaltung' },
    { src: controlSheetDE, alt: 'Kontrollblatt - SHV-Nachweis erstellen und Fortschritt tracken' },
    { src: addFlightDE, alt: 'Flug hinzufügen - Neue Flüge in Flightbook erfassen' },
    { src: statisticDE, alt: 'Flightbook Statistiken - Auswertung von Flugdaten' },
    { src: tandemDE, alt: 'Tandem-Bestätigung ausfüllen - für brevetierte Tandempilot:innen' },
  ],
  fr: [
    { src: home1FR, alt: "Page d'accueil de l'app Flightbook - aperçu de la gestion des vols" },
    { src: controlSheetFR, alt: 'Feuille de contrôle - établir la preuve FSVL et suivre la progression' },
    { src: addFlightFR, alt: 'Ajouter un vol - saisir de nouveaux vols dans Flightbook' },
    { src: statisticFR, alt: 'Statistiques Flightbook - analyse des données de vol' },
    { src: tandemFR, alt: 'Remplir la confirmation tandem - pour pilotes tandem brevetés' },
  ],
};
const images = imagesByLang[lang];

const icons = [
  `<path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6Z"/>`,
  `<path d="M3,3H21V21H3V3M5,5V19H19V5H5M7.5,18A1.5,1.5 0 0,0 9,16.5A1.5,1.5 0 0,0 7.5,15A1.5,1.5 0 0,0 6,16.5A1.5,1.5 0 0,0 7.5,18M7.5,6A1.5,1.5 0 0,0 9,7.5A1.5,1.5 0 0,0 7.5,9A1.5,1.5 0 0,0 6,7.5A1.5,1.5 0 0,0 7.5,6M16.5,18A1.5,1.5 0 0,0 18,16.5A1.5,1.5 0 0,0 16.5,15A1.5,1.5 0 0,0 15,16.5A1.5,1.5 0 0,0 16.5,18M16.5,6A1.5,1.5 0 0,0 18,7.5A1.5,1.5 0 0,0 16.5,9A1.5,1.5 0 0,0 15,7.5A1.5,1.5 0 0,0 16.5,6M12,8L14,12L12,16L10,12L12,8Z"/>`,
  `<path d="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z"/>`,
  `<path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>`,
];
---

<section id="premium" class="scroll-mt-16 py-16 md:py-20 bg-gray-50 dark:bg-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="mb-10 md:mb-16 text-center">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        {title}
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <!-- Features Column -->
      <div class="space-y-8">
        {
          features.map((feature, index) => (
            <div class="flex gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 rounded-lg bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
                  <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="currentColor">
                    <Fragment set:html={icons[index]} />
                  </svg>
                </div>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">{feature.title}</h3>
                <p class="text-gray-600 dark:text-gray-400">{feature.description}</p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Slideshow Column -->
      <div class="flex justify-center">
        <div class="max-w-[250px] w-full">
          <div class="premium-slideshow-container relative rounded-lg overflow-hidden shadow-lg bg-gray-100 dark:bg-gray-800">
            {
              images.map((img, index) => (
                <div class:list={['premium-slide', index === 0 && 'active']}>
                  <Image
                    src={img.src}
                    alt={img.alt}
                    class="w-full h-auto"
                    loading="lazy"
                    widths={[250, 300]}
                    sizes="250px"
                  />
                </div>
              ))
            }
            <button class="premium-prev" aria-label="Previous slide">&#10094;</button>
            <button class="premium-next" aria-label="Next slide">&#10095;</button>
          </div>
          <div class="premium-dots-container text-center mt-4">
            {images.map((_, index) => <span class:list={['premium-dot', index === 0 && 'active']} data-slide={index} />)}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a href="https://m.flightbook.ch/register" class="btn btn-primary">
        {cta}
      </a>
    </div>
  </div>
</section>

<style>
  .premium-slideshow-container {
    position: relative;
  }

  .premium-slide {
    display: none;
  }

  .premium-slide.active {
    display: block;
  }

  .premium-prev,
  .premium-next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    width: auto;
    margin-top: -22px;
    padding: 12px;
    color: white;
    font-weight: bold;
    font-size: 16px;
    transition: 0.3s ease;
    border-radius: 0 3px 3px 0;
    user-select: none;
    background-color: rgba(0, 0, 0, 0.5);
    border: none;
  }

  .premium-next {
    right: 0;
    border-radius: 3px 0 0 3px;
  }

  .premium-prev:hover,
  .premium-next:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .premium-dots-container {
    text-align: center;
    padding: 10px 0;
  }

  .premium-dot {
    cursor: pointer;
    height: 10px;
    width: 10px;
    margin: 0 3px;
    background-color: #bbb;
    border-radius: 50%;
    display: inline-block;
    transition: background-color 0.3s ease;
  }

  .premium-dot.active,
  .premium-dot:hover {
    background-color: #1b3e71;
  }
</style>

<script>
  // Module scripts run once, but ClientRouter swaps the DOM on navigation (e.g. language switch).
  // Keep the timer at module level so a re-init can stop the one bound to the old page.
  let autoSlideInterval: number | undefined;

  function initPremiumSlideshow() {
    clearInterval(autoSlideInterval);

    const premiumSection = document.querySelector('#premium');
    if (!premiumSection) return;

    const slides = premiumSection.querySelectorAll('.premium-slide');
    const dots = premiumSection.querySelectorAll('.premium-dot');
    const prevBtn = premiumSection.querySelector('.premium-prev');
    const nextBtn = premiumSection.querySelector('.premium-next');
    let currentSlide = 0;

    function showSlide(n: number) {
      slides.forEach((slide) => slide.classList.remove('active'));
      dots.forEach((dot) => dot.classList.remove('active'));

      currentSlide = (n + slides.length) % slides.length;

      slides[currentSlide].classList.add('active');
      dots[currentSlide].classList.add('active');
    }

    function nextSlide() {
      showSlide(currentSlide + 1);
    }

    function prevSlide() {
      showSlide(currentSlide - 1);
    }

    function startAutoSlide() {
      autoSlideInterval = window.setInterval(nextSlide, 5000);
    }

    function stopAutoSlide() {
      clearInterval(autoSlideInterval);
    }

    prevBtn?.addEventListener('click', () => {
      prevSlide();
      stopAutoSlide();
      startAutoSlide();
    });

    nextBtn?.addEventListener('click', () => {
      nextSlide();
      stopAutoSlide();
      startAutoSlide();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        showSlide(index);
        stopAutoSlide();
        startAutoSlide();
      });
    });

    startAutoSlide();
  }

  // Fires on the initial load and after every ClientRouter navigation
  document.addEventListener('astro:page-load', initPremiumSlideshow);
</script>
