---
import type { ImageMetadata } from 'astro';
import ImageCarousel from '~/components/ui/ImageCarousel.astro';

interface Item {
  title: string;
  description: string;
}

interface Screenshot {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  title: string;
  intro: string;
  cta: string;
  items: Item[];
  screenshots: Screenshot[];
}

const { title, intro, cta, items, screenshots } = Astro.props;
---

<section id="premium" class="scroll-mt-16 bg-surface-dark px-7 py-28">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-14">
    <div class="flex flex-wrap items-end justify-between gap-10">
      <h2 class="font-heading text-4xl text-white max-w-[620px] lg:text-[52px]">{title}</h2>
      <p class="max-w-[400px] text-[17px] leading-relaxed text-white/60 text-pretty">{intro}</p>
    </div>

    <div class="grid gap-[72px] items-start lg:grid-cols-[1fr_340px]">
      <div
        class="grid grid-cols-1 gap-[2px] overflow-hidden rounded-[22px] border border-white/10 bg-white/10 sm:grid-cols-2"
      >
        {
          items.map((item) => (
            <div class="flex flex-col gap-3 bg-card-dark p-8">
              <h3 class="font-heading text-[21px] text-white">{item.title}</h3>
              <p class="text-[15px] leading-[1.7] text-white/60 text-pretty">{item.description}</p>
            </div>
          ))
        }
        <div class="bg-card-dark px-8 py-7 sm:col-span-2">
          <a
            href="https://m.flightbook.ch/register"
            target="_blank"
            rel="noopener"
            class="btn-gradient hover:btn-gradient-hover"
          >
            {cta}
          </a>
        </div>
      </div>

      <div class="sticky top-24 flex flex-col items-center gap-5">
        <ImageCarousel images={screenshots} theme="dark" showCaption frame="md" class="w-full" />
      </div>
    </div>
  </div>
</section>
