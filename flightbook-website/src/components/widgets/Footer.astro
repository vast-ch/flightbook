---
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
}

interface Column {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  cta: { title: string; button: string; href: string };
  columns: Array<Column>;
}

const { cta, columns = [] } = Astro.props;
---

<footer class="bg-ink px-7 pb-11 pt-18 text-white/70">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-12">
    <div
      class="flex flex-wrap items-center justify-between gap-8 rounded-[26px] border border-white/12 px-10 py-9"
      style="background:linear-gradient(120deg,rgba(56,189,248,.14),rgba(47,109,246,.06))"
    >
      <h3 class="font-heading max-w-[520px] text-[32px] text-white">{cta.title}</h3>
      <a
        href={cta.href}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-white px-7 py-3.5 text-base font-semibold text-ink transition hover:bg-sky-pale"
      >
        {cta.button}
      </a>
    </div>
    <div class="flex flex-wrap items-start justify-between gap-10 border-t border-white/10 pt-8">
      <a href={getHomePermalink()} class="flex items-center gap-[10px] text-white">
        <img src="/flightbook-icon.png" alt="Flightbook" class="h-[30px] w-[30px] rounded-[9px]" />
        <span class="font-heading text-[17px] font-bold">{SITE?.name}</span>
      </a>
      <div class="flex flex-wrap gap-14">
        {
          columns.map(({ title, links }) => (
            <div class="flex flex-col gap-[10px]">
              <span class="text-xs font-bold uppercase tracking-[0.14em] text-white/45">{title}</span>
              {links.map(({ text, href }) => (
                <a href={href} class="text-[15px] text-white/75 hover:text-white">
                  {text}
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</footer>
