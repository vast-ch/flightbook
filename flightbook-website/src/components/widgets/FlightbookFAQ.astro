---
interface FAQ {
  question: string;
  answer: string;
  steps?: string[];
}

interface Props {
  title?: string;
  faqs: FAQ[];
  schoolCtaLabel: string;
}

const { title = 'Häufig gestellte Fragen', faqs = [], schoolCtaLabel } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.steps ? [faq.answer, ...faq.steps].join('. ') : faq.answer,
    },
  })),
};
---

<section id="faq" class="scroll-mt-16 bg-surface-light px-7 py-28">
  <div class="mx-auto flex max-w-[860px] flex-col gap-10">
    <h2 class="text-center font-heading text-4xl text-heading lg:text-[52px]">{title}</h2>
    <div class="flex flex-col gap-3">
      {
        faqs.map((faq) => (
          <details name="faq" class="group overflow-hidden rounded-[18px] border border-hairline bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5.5 hover:bg-[#fafcff]">
              <h3 class="text-[17.5px] font-semibold text-heading">{faq.question}</h3>
              <span class="text-[22px] leading-none text-brand" aria-hidden="true">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>
            <div class="flex flex-col gap-3 px-6 pb-6">
              <p class="text-[15.5px] leading-[1.75] text-body text-pretty">{faq.answer}</p>
              {faq.steps && (
                <>
                  <ol class="flex flex-col gap-2 text-[15.5px] text-body" role="list">
                    {faq.steps.map((step, i) => (
                      <li class="flex gap-2.5">
                        <span class="font-bold text-brand" aria-hidden="true">
                          {i + 1}
                        </span>
                        {step}
                      </li>
                    ))}
                  </ol>
                  <a
                    href="https://instructor.flightbook.ch/school/register"
                    target="_blank"
                    rel="noopener"
                    class="text-[15px] font-semibold text-brand"
                  >
                    {schoolCtaLabel}
                  </a>
                </>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
