---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImageCarousel, { FIGURE_SHELL_CLASSES } from '~/components/ui/ImageCarousel.astro';

interface Item {
  title: string;
  description: string;
}

interface Slide {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  cta: string;
  items: Item[];
  studentImg: ImageMetadata;
  schoolSlides: Slide[];
  studentSlides: Slide[];
}

const { eyebrow, title, cta, items, studentImg, schoolSlides, studentSlides } = Astro.props;
---

<section id="schools" class="scroll-mt-16 bg-white px-7 py-28">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-20">
    <div class="flex max-w-[660px] flex-col gap-3.5">
      <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand">{eyebrow}</span>
      <h2 class="font-heading text-4xl lg:text-[52px]">{title}</h2>
    </div>

    <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.15fr]">
      <div class="flex flex-col gap-3.5">
        <h3 class="font-heading text-[26px]">{items[0].title}</h3>
        <p class="max-w-[620px] text-[16.5px] leading-[1.75] text-body text-pretty">{items[0].description}</p>
      </div>
      <div class={FIGURE_SHELL_CLASSES}>
        <Image
          src={studentImg}
          alt={items[0].title}
          class="w-full"
          loading="lazy"
          widths={[400, 600, 800]}
          sizes="(max-width: 768px) 400px, 800px"
        />
      </div>
    </div>

    <div class="grid items-center gap-14 lg:grid-cols-[1.15fr_1fr]">
      <ImageCarousel images={schoolSlides} theme="light" frame="figure" />
      <div class="flex flex-col gap-3.5">
        <h3 class="font-heading text-[26px]">{items[1].title}</h3>
        <p class="max-w-[620px] text-[16.5px] leading-[1.75] text-body text-pretty">{items[1].description}</p>
      </div>
    </div>

    <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.15fr]">
      <div class="flex flex-col items-start gap-[22px]">
        <h3 class="font-heading text-[26px]">{items[2].title}</h3>
        <p class="max-w-[620px] text-[16.5px] leading-[1.75] text-body text-pretty">{items[2].description}</p>
        <a
          href="https://instructor.flightbook.ch/school/register"
          class="rounded-full bg-heading px-7 py-3.5 text-base font-semibold text-white hover:bg-[#16273c]"
        >
          {cta}
        </a>
      </div>
      <ImageCarousel images={studentSlides} theme="light" frame="figure" />
    </div>
  </div>
</section>
