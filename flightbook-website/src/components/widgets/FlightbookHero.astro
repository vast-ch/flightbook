---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import PhoneFrame from '~/components/ui/PhoneFrame.astro';

interface Stat {
  value: string;
  label: string;
}

interface Props {
  eyebrow: string;
  titleLine1: string;
  titleLine2: string;
  subtitle: string;
  ios: string;
  android: string;
  premium: string;
  stats: Stat[];
  photo: ImageMetadata;
  screenshot: ImageMetadata;
}

const { eyebrow, titleLine1, titleLine2, subtitle, ios, android, premium, stats, photo, screenshot } = Astro.props;
---

<section id="top" class="relative overflow-hidden bg-ink">
  <Image
    src={photo}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    width={2560}
    height={1707}
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    format="webp"
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:linear-gradient(100deg,rgba(5,16,29,.94) 0%,rgba(5,16,29,.74) 46%,rgba(5,16,29,.42) 100%)"
  >
  </div>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:linear-gradient(180deg,rgba(5,16,29,.35) 0%,transparent 35%,rgba(5,16,29,.75) 100%)"
  >
  </div>

  <div
    class="relative mx-auto max-w-[1240px] px-7 py-[104px] pt-[120px] grid gap-14 items-center lg:grid-cols-[1.05fr_.95fr]"
  >
    <div class="flex flex-col items-start gap-7">
      <span class="rounded-full border border-sky/45 bg-sky/10 px-4 py-1.5 text-[13px] font-semibold text-sky-pale">
        {eyebrow}
      </span>
      <h1 class="font-heading text-white leading-[0.94] tracking-[-0.045em] text-4xl sm:text-6xl lg:text-[88px]">
        <span>{titleLine1}</span><br />
        <span class="bg-gradient-to-r from-sky-soft to-brand bg-clip-text text-transparent">{titleLine2}</span>
      </h1>
      <p class="max-w-[520px] text-xl leading-relaxed text-white/75 text-pretty">
        {subtitle}
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a
          href="https://apps.apple.com/ch/app/flightbook/id1046316231"
          target="_blank"
          rel="noopener"
          class="rounded-full bg-white px-7 py-3.5 text-base font-semibold text-ink hover:bg-sky-pale"
        >
          {ios}
        </a>
        <a
          href="https://play.google.com/store/apps/details?id=ch.flightbook.MobileFlight"
          target="_blank"
          rel="noopener"
          class="btn-on-dark"
        >
          {android}
        </a>
        <a href="https://m.flightbook.ch/settings" class="self-center pl-2 text-[15.5px] font-semibold text-sky-soft">
          {premium}
        </a>
      </div>
    </div>

    <div class="flex justify-center relative">
      <div
        class="absolute h-[340px] w-[340px] rounded-full blur-[12px]"
        style="background:radial-gradient(circle,rgba(56,189,248,.42),transparent 65%)"
      >
      </div>
      <PhoneFrame radius="lg" float class="relative w-72">
        <Image src={screenshot} alt="" class="w-full" />
      </PhoneFrame>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="mx-auto max-w-[1240px] px-7 py-6 grid gap-6 grid-cols-2 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="flex flex-col gap-1">
            <span class="font-heading text-[21px] leading-tight text-white">{stat.value}</span>
            <span class="text-[13px] uppercase tracking-[0.12em] text-white/50">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
