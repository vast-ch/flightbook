---
interface PricingPlan {
  badge: string;
  title: string;
  price: string;
  period?: string;
  features: string[];
  cta: string;
  ctaLink: string;
  featured?: boolean;
}

interface Props {
  title: string;
  intro: string;
  plans: PricingPlan[];
  notes: string[];
}

const { title, intro, plans, notes } = Astro.props;
---

<section id="angebot" class="scroll-mt-16 bg-surface-light px-7 py-28">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-12">
    <div class="flex flex-col items-center gap-3.5 text-center">
      <h2 class="font-heading text-4xl text-heading lg:text-[52px]">{title}</h2>
      <p class="text-base text-[#5a6b7d]">{intro}</p>
    </div>

    <div class="grid items-start gap-5 md:grid-cols-3">
      {
        plans.map((plan) =>
          plan.featured ? (
            <div
              data-featured
              class="relative flex min-h-[500px] flex-col gap-4.5 overflow-hidden rounded-3xl bg-[linear-gradient(165deg,#0d1b2d,#122c4d)] p-8 shadow-[0_40px_70px_-34px_rgba(11,22,38,0.6)]"
            >
              <div class="absolute -top-15 -right-10 h-[220px] w-[220px] rounded-full bg-[radial-gradient(circle,rgba(56,189,248,.35),transparent_65%)]" />
              <span class="relative text-xs font-bold uppercase tracking-[0.14em] text-sky-soft">{plan.badge}</span>
              <h3 class="relative font-heading text-[26px] text-white">{plan.title}</h3>
              <p class="relative font-heading text-[38px] font-bold tracking-[-0.03em] text-white">
                {plan.price}
                {plan.period && <span class="font-sans text-base font-medium text-white/60"> {plan.period}</span>}
              </p>
              <ul class="relative flex flex-1 flex-col gap-3">
                {plan.features.map((feature) => (
                  <li class="flex gap-3 text-[15px] text-white/75">
                    <span class="text-sky-soft">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <a href={plan.ctaLink} class="btn-gradient hover:btn-gradient-hover relative w-full text-center">
                {plan.cta}
              </a>
            </div>
          ) : (
            <div class="flex min-h-[460px] flex-col gap-4.5 rounded-3xl border border-hairline bg-white p-8">
              <span class="text-xs font-bold uppercase tracking-[0.14em] text-muted-light">{plan.badge}</span>
              <h3 class="font-heading text-[26px] text-heading">{plan.title}</h3>
              <p class="font-heading text-[38px] font-bold tracking-[-0.03em] text-heading">
                {plan.price}
                {plan.period && <span class="text-base font-medium text-muted-light"> {plan.period}</span>}
              </p>
              <ul class="flex flex-1 flex-col gap-3">
                {plan.features.map((feature) => (
                  <li class="flex gap-3 text-[15px] text-body">
                    <span class="text-brand">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <a href={plan.ctaLink} class="btn-outline-light text-center">
                {plan.cta}
              </a>
            </div>
          )
        )
      }
    </div>

    <div class="mx-auto flex max-w-[760px] flex-col gap-3 text-center text-sm leading-relaxed text-muted-light">
      {notes.map((note) => <p>{note}</p>)}
    </div>
  </div>
</section>
